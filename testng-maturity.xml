<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="MaturityTest">
    <parameter name="category" value="ui"/>
    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
        <listener class-name="listeners.AllureListener"/>
        <listener class-name="listeners.FailureAnalyticsListener"/>
        <listener class-name="listeners.SuiteListener"/>
        <listener class-name="listeners.TestListener"/>
    </listeners>
    <test name="Organization maturity assessments">
        <classes>
            <class name="tests.ui.PRO.MaturityAssessmentTest">
                <methods>
                    <include name="MaturityAssesmentOrganisationRespondToAssesement"/>
                    <include name="IntiateAndDiscardMaturityAssessmentAtOrgLevel"/>
                    <include name="BaseLineOrganisationMaturtiyAssesement"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
