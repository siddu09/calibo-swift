<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Calibo Automation Suite">
    <parameter name="category" value="combined"/>
    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
        <listener class-name="listeners.AllureListener"/>
        <listener class-name="listeners.FailureAnalyticsListener"/>
        <listener class-name="listeners.SuiteListener"/>
<!--        <listener class-name="listeners.RetryTransformer"/>-->
        <listener class-name="listeners.TestListener"/>
    </listeners>


<test name="UI Automation + Self-Healing">
    <classes>
        <class name="tests.ui.LoginTest"/>
    </classes>
</test>
</suite>